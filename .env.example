# Copy to .env and fill in. .env is git-ignored.
#
# ---- Bundled into the app (EXPO_PUBLIC_*) — public values only ----
# Supabase Dashboard -> Project Settings -> API. Use the anon/publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Display settings (optional)
EXPO_PUBLIC_CURRENCY_SYMBOL=£
EXPO_PUBLIC_DISTANCE_UNIT=mi
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# ---- Build time only (read by app.config.ts, not bundled) ----
# Google Maps SDK for Android key, restricted to package com.automod.app
GOOGLE_MAPS_API_KEY=
# From `eas init` (enables push notifications and EAS Update)
EAS_PROJECT_ID=

# ---- Seed script only (npm run db:seed). NEVER prefix with EXPO_PUBLIC_ ----
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SEED_PASSWORD=
