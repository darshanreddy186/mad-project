{
  "name": "automod",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env EXPO_NO_TELEMETRY=1 expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase db start",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts && prettier --write types/database.ts",
    "db:push": "supabase db push",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "build:android:preview": "eas build -p android --profile preview",
    "build:android:production": "eas build -p android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.58.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^0.544.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "@types/react-native-maps": "^0.24.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3"
  }
}
